# 依赖
node_modules/
.npm-cache/

# ── 本地配置与运行时数据（永远不入库）─────────────────────────────
# config.json 含 OneBot token、控制台令牌、真实群号、owner QQ
config.json
config.json.bak*
# state/ 含群聊内容、学习本、token 用量、日志、令牌
state/
# 个人音频素材（语音库）
audio/
logs/
*.log

# ── 备份与临时产物 ──────────────────────────────────────────────
*.bak
*.bak-*
*.tmp
*.stub-*

# 本机专用的隐私扫描规则（含真实 QQ 号 / 本机路径）
scripts/privacy-rules.json

# 独立「发语音」工具（在仓库外；万一被放进同一目录也别提交）
voice-tool/

# 大体积演示视频走 Release 附件，不入库
assets/*.mp4

# ── 编辑器 / 系统 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
