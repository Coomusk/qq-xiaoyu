# 行尾：只对**必须有固定行尾**的类型钉死，其余交给 git 的 text=auto。
#
# 踩过的坑：`scripts/test-preset-prompt.mjs` 有一条断言「写回时沿用文件的主导行尾，
# 不得吞掉块尾空行」，读的是真实的 `dsh/agent-presets/*/agent.cordis.yml`。
# 只要 checkout 出来的行尾随平台/`core.autocrlf` 变化，这条断言就会在别人的 clone 上红，
# 而作者本地（文件没被重新 checkout）看不出来。所以 preset 显式钉成 CRLF。
* text=auto

# preset 源文件与控制台写回的目标：固定 CRLF（bridge 与测试都按 CRLF 读回）
dsh/agent-presets/**/*.yml  text eol=crlf
plugins/qq-agent-presets/presets/*.yml  text eol=crlf


# Windows 批处理必须 CRLF，否则 cmd 解析出错
*.bat   text eol=crlf
*.cmd   text eol=crlf
# PowerShell 脚本与 .vbs 同理
*.ps1   text eol=crlf
*.vbs   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.zip   binary

# 语言统计：测试夹具不算入项目语言
scripts/fixtures/** linguist-vendored
